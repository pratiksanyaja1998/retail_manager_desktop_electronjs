{
  "name": "retail-manager",
  "version": "2.2.0",
  "description": "Manager Your Retail Shope ...",
  "main": "main.js",
  "email": "pratiksanyaja1998@gmail.com",
  "homepage": "./",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron .",
    "build": "electron-packager .",
    "rebuild": "electron-rebuild -f -w sqlite3",
    "pack": "build --dir",
    "dist": "build",
    "deploy": "electron-builder build --win --publish always"
  },
  "keywords": [
    "retail manager",
    "accounting software"
  ],
  "author": "Pratik Sanyaja <pratiksanyaja1998@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pratiksanyaja1998/retail_manager_desktop_electronjs.git"
  },
  "devDependencies": {
    "electron": "^5.0.2",
    "electron-builder": "^20.41.1",
    "electron-packager": "^13.1.1",
    "electron-rebuild": "^1.8.5"
  },
  "dependencies": {
    "jquery": "^3.3.1",
    "knex": "^0.15.2",
    "mixpanel-browser": "^2.42.0",
    "nodemailer": "^6.7.2",
    "sqlite3": "^4.0.2"
  },
  "build": {
    "appId": "retail.spyhunteritsolution.in",
    "productName": "Retail Manager",
    "linux": {
      "target": "deb",
      "category": "bussiness",
      "icon": "src/assets/app.png"
    },
    "win": {
      "target": "NSIS",
      "icon": "src/assets/app.png"
    }
  }
}
